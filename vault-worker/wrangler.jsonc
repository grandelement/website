{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ge-studios-vault",
  "main": "src/index.js",
  "compatibility_date": "2026-09-27",
  "d1_databases": [
    {
      "binding": "VAULT_DB",
      "database_name": "ge-studios-vault",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID"
    }
  ],
  "vars": {
    "ALLOWED_ORIGINS": "https://grandelement.com,https://www.grandelement.com,https://radio.grandelement.blitz.cloud"
  },
  "secrets": {
    "required": [
      "VAULT_ADMIN_TOKEN",
      "VAULT_INGEST_TOKEN",
      "VAULT_HASH_KEY",
      "VAULT_ENCRYPTION_KEY_B64"
    ]
  }
}
