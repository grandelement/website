{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ge-studios-vault",
  "main": "src/index.js",
  "compatibility_date": "2026-09-27",
  "d1_databases": [
    {
      "binding": "VAULT_DB",
      "database_name": "ge-studios-vault",
      "database_id": "2f91cefe-5aa9-4721-b4ed-de574015d5e0"
    }
  ],
  "vars": {
    "ALLOWED_ORIGINS": "https://grandelement.com,https://www.grandelement.com,https://grandelement.github.io,https://radio.grandelement.blitz.cloud"
  },
  "secrets": {
    "required": [
      "VAULT_ADMIN_TOKEN",
      "VAULT_INGEST_TOKEN",
      "VAULT_HASH_KEY",
      "VAULT_ENCRYPTION_KEY_B64"
    ]
  },
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "vault.grandelement.com",
      "zone_name": "grandelement.com",
      "custom_domain": true
    }
  ]
}
