FROM debian:bookworm-slim

ENV DEBIAN_FRONTEND=noninteractive
ENV DISPLAY=:99

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
       ca-certificates \
       chromium \
       ffmpeg \
       fonts-dejavu-core \
       xvfb \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY --chmod=0755 youtube-live/start-youtube.sh /app/start-youtube.sh

STOPSIGNAL SIGTERM
CMD ["/app/start-youtube.sh"]
