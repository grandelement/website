# Grand Element Radio 24/7 backend for blitz.cloud
# PUBLIC-PROXY VERSION
#
# Replace the ROOT file in grandelement/website:
# Dockerfile.radio
#
# Architecture:
# GitHub music library -> Liquidsoap -> Icecast on internal port 8000
# -> Nginx streaming proxy on Blitz public port 8080
#
# Public listener URL remains:
# https://radio.grandelement.blitz.cloud/stream.mp3
#
# The website Index DOES NOT need to change.

FROM debian:bookworm-slim

ENV DEBIAN_FRONTEND=noninteractive
ENV PORT=8080
ENV HOME=/app/home
ENV XDG_CACHE_HOME=/app/home/.cache

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
       ca-certificates \
       ffmpeg \
       icecast2 \
       liquidsoap \
       nginx \
       python3 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

RUN mkdir -p \
       /app/runtime \
       /app/runtime/client_temp \
       /app/runtime/proxy_temp \
       /app/logs \
       /app/home/.cache \
    && chown -R 1000:1000 /app

RUN printf '%s' '' | base64 -d > /app/library-watcher.py \
    && printf '%s' '' | base64 -d > /app/start-radio.sh \
    && chmod 755 /app/library-watcher.py /app/start-radio.sh \
    && chown 1000:1000 /app/library-watcher.py /app/start-radio.sh

USER 1000:1000

EXPOSE 8080

CMD ["/app/start-radio.sh"]
