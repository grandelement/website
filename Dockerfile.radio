# Grand Element Radio backend v5.0 CLOUD SAFE
# Blitz-compatible split build: non-root runtime, port 8080, small source files.
FROM debian:bookworm-slim

# Keep these first build layers aligned with the working v4.x image so Blitz can reuse its heavy package cache.
ENV DEBIAN_FRONTEND=noninteractive
ENV PORT=8080
ENV HOME=/app/home
ENV XDG_CACHE_HOME=/app/home/.cache

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
       ca-certificates \
       ffmpeg \
       git \
       icecast2 \
       liquidsoap \
       nginx \
       python3 \
       python3-zmq \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

RUN mkdir -p /app/runtime /app/runtime/client_temp /app/runtime/proxy_temp /app/runtime/fastcgi_temp /app/runtime/uwsgi_temp /app/runtime/scgi_temp /app/logs /app/home/.cache \
    && chown -R 1000:1000 /app

# New v5 data folder comes after the cached base layers.
ENV GE_DATA_DIR=/app/data
ENV PYTHONUNBUFFERED=1
RUN mkdir -p /app/data && chown 1000:1000 /app/data

COPY --chown=1000:1000 --chmod=0755 radio-backend/library-watcher.py /app/library-watcher.py
COPY --chown=1000:1000 --chmod=0755 radio-backend/control-server.py /app/control-server.py
COPY --chown=1000:1000 --chmod=0755 radio-backend/start-radio.sh /app/start-radio.sh
COPY --chown=1000:1000 radio-backend/dj.html /app/dj.html
COPY --chown=1000:1000 radio-backend/live-dj.html /app/live-dj.html
COPY --chown=1000:1000 radio-backend/live-dj.css /app/live-dj.css
COPY --chown=1000:1000 radio-backend/live-dj.js /app/live-dj.js
COPY --chown=1000:1000 radio-backend/pcm-worklet.js /app/pcm-worklet.js

# One kept folder for station settings and saved custom mixes.
VOLUME ["/app/data"]

USER 1000:1000
EXPOSE 8080
STOPSIGNAL SIGTERM
CMD ["/app/start-radio.sh"]
