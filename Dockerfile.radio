# Grand Element Radio 24/7 backend for blitz.cloud
# SMALL REMOTE-LIBRARY VERSION
#
# Upload/replace this file at the ROOT of grandelement/website as:
# Dockerfile.radio
#
# This image DOES NOT copy the ~774 MB music library into the build.
# At runtime it reads the public Grand Element library from GitHub.
# It checks the repository every 5 minutes and refreshes the future playlist
# only when songs/station IDs have actually changed.
#
# Listener stream:
# https://radio.grandelement.blitz.cloud/stream.mp3

FROM debian:bookworm-slim

ENV DEBIAN_FRONTEND=noninteractive
ENV PORT=8080
ENV HOME=/app/home
ENV XDG_CACHE_HOME=/app/home/.cache

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
       ca-certificates \
       ffmpeg \
       icecast2 \
       liquidsoap \
       python3 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

RUN mkdir -p /app/runtime /app/logs /app/home/.cache \
    && chown -R 1000:1000 /app

RUN printf '%s' '' | base64 -d > /app/library-watcher.py \
    && printf '%s' '' | base64 -d > /app/start-radio.sh \
    && chmod 755 /app/library-watcher.py /app/start-radio.sh \
    && chown 1000:1000 /app/library-watcher.py /app/start-radio.sh

USER 1000:1000

EXPOSE 8080

CMD ["/app/start-radio.sh"]
