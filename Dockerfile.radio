# Grand Element Radio 24/7 backend for blitz.cloud
# Upload this file to the ROOT of grandelement/website as: Dockerfile.radio
#
# Stream URL after deployment:
# https://radio.grandelement.blitz.cloud/stream.mp3
#
# Uses the existing repository folders:
#   ge-music/music   = songs
#   ge-music/clips   = station IDs
#
# A station ID is automatically inserted after every 4-6 songs.
# No database, no persistent volume, and no secret settings are required.

FROM debian:bookworm-slim

ENV DEBIAN_FRONTEND=noninteractive
ENV PORT=8080
ENV HOME=/app/home
ENV XDG_CACHE_HOME=/app/home/.cache

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
       ca-certificates \
       ffmpeg \
       icecast2 \
       liquidsoap \
       python3 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Only copy the music library needed by the radio engine.
COPY ge-music /app/ge-music

RUN mkdir -p /app/runtime /app/logs /app/home/.cache \
    && chown -R 1000:1000 /app

# The complete startup/configuration script is embedded here so this remains
# a one-file upload.
RUN printf '%s' '' | base64 -d > /app/start-radio.sh \
    && chmod 755 /app/start-radio.sh \
    && chown 1000:1000 /app/start-radio.sh

USER 1000:1000

EXPOSE 8080

CMD ["/app/start-radio.sh"]
