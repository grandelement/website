# Grand Element Radio backend v4.9
# CORE-FIRST + CROSSFADE + PRIVATE DJ CONTROL CONSOLE
# DJ Voice + direct input + EQ/compression + automatic master-stream ducking + temporary MP3 upload
# v4.9 SPLIT BUILD: source files copied from radio-backend/ with corrected RUN syntax
#
# Replace the ROOT file in grandelement/website:
# Dockerfile.radio
#
# Public stream stays:
# https://radio.grandelement.blitz.cloud/stream.mp3
#
# Private DJ console:
# https://radio.grandelement.blitz.cloud/dj/
#
# Before using the DJ console, set a Blitz Environment variable:
# DJ_PASSWORD = a password only you know
# Username is: dj
#
# Music remains in the GitHub ge-music library and is not copied into the image.

FROM debian:bookworm-slim

ENV DEBIAN_FRONTEND=noninteractive
ENV PORT=8080
ENV HOME=/app/home
ENV XDG_CACHE_HOME=/app/home/.cache

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
       ca-certificates \
       ffmpeg \
       git \
       icecast2 \
       liquidsoap \
       nginx \
       python3 \
       python3-zmq \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

RUN mkdir -p /app/runtime /app/runtime/client_temp /app/runtime/proxy_temp /app/runtime/fastcgi_temp /app/runtime/uwsgi_temp /app/runtime/scgi_temp /app/logs /app/home/.cache \
    && chown -R 1000:1000 /app

# Radio application files are kept as normal build-context files.
# This avoids very long encoded Dockerfile lines that Blitz cannot parse.
COPY radio-backend/library-watcher.py /app/library-watcher.py
COPY radio-backend/control-server.py /app/control-server.py
COPY radio-backend/dj.html /app/dj.html
COPY radio-backend/live-dj.html /app/live-dj.html
COPY radio-backend/start-radio.sh /app/start-radio.sh

RUN chmod 755 /app/library-watcher.py /app/control-server.py /app/start-radio.sh \
    && chown 1000:1000 /app/library-watcher.py /app/control-server.py /app/dj.html /app/live-dj.html /app/start-radio.sh

USER 1000:1000

EXPOSE 8080

CMD ["/app/start-radio.sh"]
